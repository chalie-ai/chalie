services:
  # Development environment (port 8081)
  # Mounts local code for hot-reload and testing
  chalie-dev:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: chalie-dev
    ports:
      - "8081:8081"
    volumes:
      - ./backend:/app/backend
      - ./frontend:/app/frontend
      - ./run.sh:/app/run.sh
      - chalie_dev_data:/data
    environment:
      - CHALIE_DB_PATH=/data/chalie.db
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/system/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # Marcos (port 8083)
  # Runs published Docker Hub image
  chalie-marcos:
    image: chalieai/chalie:latest
    container_name: chalie-marcos
    ports:
      - "8083:8081"
    volumes:
      - chalie_marcos_data:/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/system/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # Geza — investor instance (port 8084)
  # Runs published Docker Hub image
  chalie-geza:
    image: chalieai/chalie:latest
    container_name: chalie-geza
    ports:
      - "8084:8081"
    volumes:
      - chalie_geza_data:/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/system/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # Jeanette (port 8085)
  # Runs published Docker Hub image
  chalie-jeanette:
    image: chalieai/chalie:latest
    container_name: chalie-jeanette
    ports:
      - "8085:8081"
    volumes:
      - chalie_jeanette_data:/data
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8081/system/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

volumes:
  chalie_dev_data:
  chalie_marcos_data:
    external: true
    name: chalie_chalie_marcos_data
  chalie_geza_data:
  chalie_jeanette_data:
