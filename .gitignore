# Environment & secrets
*.env
*.key
*.session_secret
backend/.env
backend/.key
# Dev-only auto-login credentials (see FileMapperService.get_dev_credentials_path)
/credentials.json
# Runtime state — entire /data tree is local-only, never committed.
# Includes data/mcp_tools.sqlite — the dynamic MCP client tool index
# managed by McpClientService (rebuilt from remote servers at runtime).
data/
# Install-time artifact — voice models created by install.sh, not git-tracked.
resources/
*.db
*.db-journal
*.db-wal
*.db-shm
backend/configs/generated/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.deps-installed
.voice-deps-installed

# Editor & OS
.idea/
.vscode/
.DS_Store
.claude/
.coding_agent/
Claude.md
CLAUDE.md


# Frontend build artifacts (none currently, vanilla JS)
node_modules/
frontend/_interfaces

docker-compose.yml
.aider*

# LLM request logs (verbatim, one file per request, never committed)
/logs/

# Merge/editor/run artifacts — never commit
*.orig
*.rej
*.bak
*.tmp
*~
# Stash-suffixed files (e.g. foo.json~abc123... commit-msg) left by partial merges
*~*... *
backend/.build_baseline.json
backend/.simplify_baseline.json*
backend/.simplify_test_results.xml*
.sonar_issues_p*.json

# Local scratch/working dir — ad-hoc scripts, repro harnesses, planning notes
.scratch/
# Python packaging build metadata (regenerated by pip install -e . / setup.py)
*.egg-info/

# Superpowers dev plans/specs — local planning notes, never committed
docs/superpowers/
backend/docs/superpowers/

# Vue frontend workspace
# The built app dists are COMMITTED so source/tarball installs ship
# ready-to-serve assets without a Node/pnpm build step. Other dist/ dirs
# (shared packages, build intermediates) stay ignored.
frontend/**/dist/
!frontend/apps/interface/dist/
!frontend/apps/interface/dist/**
!frontend/apps/brain/dist/
!frontend/apps/brain/dist/**
frontend/apps/*/test-results/
frontend/apps/*/playwright-report/
frontend/**/.auth/

# design-sync staged scripts + build output
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/node_modules
