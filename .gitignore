# Environment & secrets
*.env
*.key
*.session_secret
backend/.env
backend/.key
# Runtime state — entire /data tree is local-only, never committed.
# Includes data/mcp_tools.sqlite — the dynamic MCP client tool index
# managed by McpClientService (rebuilt from remote servers at runtime).
data/
# Install-time artifact — voice models created by install.sh, not git-tracked.
resources/
*.db
*.db-journal
*.db-wal
*.db-shm
backend/configs/generated/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.deps-installed
.voice-deps-installed

# Editor & OS
.idea/
.vscode/
.DS_Store
.claude/
Claude.md
CLAUDE.md


# Frontend build artifacts (none currently, vanilla JS)
node_modules/
frontend/_interfaces

docker-compose.yml
.aider*

# LLM request logs (verbatim, one file per request, never committed)
/logs/

# Merge/editor/run artifacts — never commit
*.orig
*.rej
*.bak
*.tmp
*~
# Stash-suffixed files (e.g. foo.json~abc123... commit-msg) left by partial merges
*~*... *
backend/.build_baseline.json
backend/.simplify_baseline.json*
backend/.simplify_test_results.xml*
.sonar_issues_p*.json
